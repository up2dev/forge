DATABASE_URL=sqlite+aiosqlite:///./forge.db
FORGE_SQL_ECHO=0

FORGE_TOKEN_TTL_MINUTES=10080

FORGE_LOGIN_RATE_LIMIT_TIMES=5
FORGE_LOGIN_RATE_LIMIT_SECONDS=60

FORGE_DEFAULT_LOCALE=en
FORGE_SUPPORTED_LOCALES=en,fr

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=0
MAIL_FROM=noreply@example.test
MAIL_FROM_NAME=Forge
FORGE_BRAND_COLOR=#4f46e5

FORGE_MFA_ENABLED=1
FORGE_MFA_ISSUER=Forge
FORGE_MFA_METHODS=totp,email,webauthn
FORGE_MFA_PENDING_TTL_MINUTES=10
FORGE_MFA_EMAIL_CODE_TTL_MINUTES=10
# Codes faux tolérés sur un même pending_token avant de le détruire.
FORGE_MFA_MAX_ATTEMPTS=5

# Clé de chiffrement des secrets TOTP au repos. Vide en dev = repli
# connu, insuffisant pour de vraies données — à générer avant tout
# déploiement réel (ex. openssl rand -base64 32) et à garder stable
# (la changer rend tous les secrets TOTP existants indéchiffrables).
FORGE_APP_KEY=

# rp_id doit être le domaine exact vu par le navigateur (sans port ni
# schéma) — "localhost" en dev. FORGE_WEBAUTHN_ORIGIN doit correspondre
# exactement (schéma + domaine + port) à l'URL depuis laquelle l'app
# est servie, sinon toute vérification WebAuthn échoue.
FORGE_WEBAUTHN_RP_ID=localhost
FORGE_WEBAUTHN_RP_NAME=Forge
FORGE_WEBAUTHN_ORIGIN=http://localhost:8000
FORGE_MFA_BYPASS_PERMISSION=
# Permission qui autorise à désactiver sa dernière méthode MFA même
# sous inscription forcée. Vide = personne, garde-fou absolu.
FORGE_MFA_FORCE_DISABLE_PERMISSION=
FORGE_MFA_FORCE_ENROLLMENT=0

FORGE_LOG_DIR=storage/logs
FORGE_LOG_LEVEL=INFO
FORGE_LOG_MAX_BYTES=5000000
FORGE_LOG_BACKUP_COUNT=5
# "file" (défaut) ou "mongo"
FORGE_LOG_BACKEND=file
FORGE_LOG_MONGO_URL=mongodb://localhost:27017
FORGE_LOG_MONGO_DB=forge_logs
FORGE_LOG_MONGO_COLLECTION=logs

FORGE_STORAGE_DIR=storage/files
FORGE_STORAGE_MAX_BYTES=25000000
FORGE_STORAGE_CHUNK_SIZE=1000000

# Reset de mot de passe par email. Le lien pointe vers le FRONT
# (FORGE_FRONTEND_URL + FORGE_FRONTEND_PWD_RESET_PATH), pas vers l'API.
FORGE_PWD_RESET_TOKEN_TTL_MINUTES=60
# Révoque les sessions ouvertes (tokens d'accès) au reset.
FORGE_PWD_RESET_REVOKES_SESSIONS=1
FORGE_FRONTEND_URL=http://localhost:5173
FORGE_FRONTEND_PWD_RESET_PATH=/reset-password

# Fuseau des expressions cron du planificateur (ex. Europe/Paris).
FORGE_SCHEDULER_TIMEZONE=UTC
