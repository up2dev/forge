# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Base locale (hors Docker)
forge.db
test.db

# Fichiers uploadés + logs (contenu réel, jamais commité) — le / de
# tête est indispensable : "storage/" sans lui matcherait aussi
# forge/storage/, le MODULE de code du stockage de fichiers (routes,
# modèles, service...), pas seulement ce dossier racine de données.
/storage/

# OS / éditeurs
.DS_Store
Thumbs.db
*Zone.Identifier*

# Env — .env (dev) reste volontairement COMMITÉ : ses valeurs
# (forge/forge, changeme...) n'ont aucune conséquence en local, et
# docker-compose.yml en a besoin pour démarrer (env_file: .env). Seuls
# les fichiers contenant de VRAIS secrets sont exclus.
.env.prod
.env.*.local
