meta {
  name: Password forgot
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/pwd/forgot
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@example.test"
  }
}

docs {
  Même réponse 200 que le compte existe ou non (pas d'énumération).
  L'email part vers Mailpit en dev : http://localhost:8025 — le lien
  contient ?token=XXX, à copier dans Password reset.
}
